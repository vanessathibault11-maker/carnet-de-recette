---
// Polices auto-hébergées — aucune requête vers un service externe.
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  titre: string;
  description: string;
  /** JSON-LD (Schema.org) déjà sérialisé, injecté tel quel dans le <head>. */
  jsonLd?: string;
  /** Chemin canonique optionnel (par défaut, l'URL courante). */
  canonical?: string;
  /** Page personnelle (panier, carnet) : rien à indexer, le contenu est local. */
  noindex?: boolean;
}

const { titre, description, jsonLd, canonical, noindex } = Astro.props;
const urlCanonique = new URL(canonical ?? Astro.url.pathname, Astro.site);
const titreComplet = titre.includes('Le carnet de recettes')
  ? titre
  : `${titre} · Le carnet de recettes`;
---

<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={urlCanonique.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Réseaux sociaux -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Le carnet de recettes" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_CA" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a href="#contenu-principal" class="skip-link">Aller au contenu</a>
    <Header />
    <main id="contenu-principal">
      <slot />
    </main>
    <Footer />

    {/*
      Cloudflare Web Analytics — statistiques SANS témoins (donc aucune bannière
      de consentement requise). À ACTIVER après le déploiement :
      1. Tableau de bord Cloudflare → Web Analytics → Add a site.
      2. Copier le token fourni, puis décommenter la balise ci-dessous en y
         mettant ton token. Aucune autre modification de code n'est nécessaire.
      Ne JAMAIS ajouter Google Analytics (témoins + conformité Loi 25).

      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token": "REMPLACER_PAR_TON_TOKEN"}'
      ></script>
    */}
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main {
    flex: 1;
  }
</style>
