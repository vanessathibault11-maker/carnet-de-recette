---
const annee = new Date().getFullYear();
---

<footer class="pied">
  <div class="contenu pied__inner">
    <p class="pied__marque">Le carnet de recettes</p>
    <p class="pied__ligne">
      Le menu de la semaine, sain et sans prise de tête. Recettes rapides, budget
      maîtrisé, approuvées par les enfants.
    </p>
    <nav class="pied__nav" aria-label="Liens de pied de page">
      <a href="/recettes/">Recettes</a>
      <a href="/blog/">Blogue</a>
      <a href="/mon-carnet/">Mon carnet</a>
      <a href="/panier/">Ma liste d'épicerie</a>
    </nav>
    <p class="pied__copy">© {annee} · Fait au Québec</p>
  </div>
</footer>

<style>
  .pied {
    background: var(--vert);
    color: #eef3ef;
    margin-top: auto;
  }
  .pied__inner {
    padding-block: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pied__marque {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: #fff;
    margin: 0;
  }
  .pied__ligne {
    margin: 0;
    max-width: 46ch;
    color: #d7e3db;
  }
  .pied__nav {
    display: flex;
    gap: 16px;
    margin-top: 6px;
    font-family: var(--mono);
    font-size: 13px;
  }
  .pied__nav a {
    color: #fff;
    text-decoration: none;
  }
  .pied__nav a:hover {
    text-decoration: underline;
  }
  .pied__copy {
    margin: 10px 0 0;
    font-family: var(--mono);
    font-size: 12px;
    color: #b9ccc0;
  }
</style>
