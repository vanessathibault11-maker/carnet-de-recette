---
// Petit emblème de catégorie — un disque à la couleur de la catégorie avec une
// icône au trait fin (banque src/visuels/icones/). Discret, pas de grand
// bandeau. JAMAIS de photo. L'icône hérite de la couleur `texteSur` de la
// catégorie (currentColor) pour rester lisible sur fond clair comme foncé.
import { getCategorie } from '../lib/categories';

interface Props {
  categorie: string;
  /** Contenu brut du fichier icône SVG à afficher. */
  icone?: string;
  titre: string;
  /** Taille du disque (par défaut 64px). */
  taille?: string;
}

const { categorie, icone, titre, taille = '64px' } = Astro.props;
const cat = getCategorie(categorie);
---

<span
  class="embleme"
  style={`--c:${cat.couleur}; --ink:${cat.texteSur}; --s:${taille};`}
  role="img"
  aria-label={`Catégorie : ${cat.label} — ${titre}`}
>
  {icone && <Fragment set:html={icone} />}
</span>

<style>
  .embleme {
    display: inline-grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: var(--c);
    color: var(--ink);
    flex-shrink: 0;
    box-shadow: var(--ombre-douce);
  }
  .embleme :global(svg) {
    width: 58%;
    height: 58%;
    display: block;
  }
</style>
