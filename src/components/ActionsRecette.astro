---
// Deux actions perso sur une recette : favori et panier d'épicerie.
// Rendues à côté de la carte (jamais DANS le lien) et synchronisées avec le
// stockage local au chargement — le HTML est statique et identique pour tout
// le monde, l'état personnel arrive côté client.
interface Props {
  slug: string;
  titre: string;
  portions: number;
  /** `carte` = pastilles flottantes sur la vignette ; `page` = boutons pleins. */
  variante?: 'carte' | 'page';
}
const { slug, titre, portions, variante = 'carte' } = Astro.props;
---

<div class={`actions actions--${variante}`} data-actions>
  <button
    type="button"
    class="action action--fav"
    data-fav-btn
    data-slug={slug}
    aria-pressed="false"
    aria-label={`Ajouter « ${titre} » à mes favoris`}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M12 20.2 4.6 13a4.6 4.6 0 0 1 6.5-6.5l.9.9.9-.9A4.6 4.6 0 1 1 19.4 13z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linejoin="round"
      ></path>
    </svg>
    {variante === 'page' && <span class="action__txt" data-fav-txt>Ajouter aux favoris</span>}
  </button>

  <button
    type="button"
    class="action action--panier"
    data-panier-btn
    data-slug={slug}
    data-portions={portions}
    aria-pressed="false"
    aria-label={`Ajouter « ${titre} » à ma liste d'épicerie`}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M3.5 5.5h2l2.2 9.2a1.6 1.6 0 0 0 1.6 1.3h7.3a1.6 1.6 0 0 0 1.6-1.2l1.4-5.6H6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <circle cx="10" cy="19.5" r="1.4" fill="currentColor"></circle>
      <circle cx="17" cy="19.5" r="1.4" fill="currentColor"></circle>
    </svg>
    {variante === 'page' && <span class="action__txt" data-panier-txt>Ajouter à ma liste</span>}
  </button>
</div>

<style>
  .actions {
    display: flex;
    gap: 8px;
  }
  /* Sur une carte : posées en bas à droite. ItemRecette réserve la place en
     bas de la carte pour qu'elles ne recouvrent jamais du texte. */
  .actions--carte {
    position: absolute;
    right: 16px;
    bottom: 14px;
    z-index: 2;
  }
  .actions--page {
    margin-top: 18px;
    flex-wrap: wrap;
  }

  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 38px;
    min-height: 38px;
    padding: 0 9px;
    border: 1px solid var(--bordure);
    border-radius: 999px;
    background: var(--blanc);
    color: var(--gris-texte);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .actions--page .action {
    min-height: 44px;
    padding: 0 18px;
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
  }
  .action svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
  .action:hover {
    color: var(--vert);
    border-color: var(--vert);
  }
  .action:focus-visible {
    outline: 2px solid var(--vert);
    outline-offset: 2px;
  }

  /* État actif : la pastille se remplit à la couleur de l'action. */
  .action--fav[aria-pressed='true'] {
    color: var(--terracotta);
    border-color: var(--terracotta);
    background: #fdf1ec;
  }
  .action--fav[aria-pressed='true'] svg path {
    fill: currentColor;
  }
  .action--panier[aria-pressed='true'] {
    color: var(--vert);
    border-color: var(--vert);
    background: #eef4ef;
  }

  @media (prefers-reduced-motion: reduce) {
    .action {
      transition: none;
    }
  }
</style>

<script>
  import {
    basculerFavori,
    basculerPanier,
    lireFavoris,
    lirePanier,
    EVENEMENT_MAJ,
  } from '../lib/carnetLocal';

  // Un seul script pour TOUS les boutons de la page (Astro ne l'inclut qu'une
  // fois, même si le composant est rendu 20 fois).
  const synchroniser = () => {
    const favoris = new Set(lireFavoris());
    const panier = lirePanier();

    document.querySelectorAll<HTMLButtonElement>('[data-fav-btn]').forEach((b) => {
      const actif = favoris.has(b.dataset.slug ?? '');
      b.setAttribute('aria-pressed', String(actif));
      const txt = b.querySelector('[data-fav-txt]');
      if (txt) txt.textContent = actif ? 'Dans mes favoris' : 'Ajouter aux favoris';
    });

    document.querySelectorAll<HTMLButtonElement>('[data-panier-btn]').forEach((b) => {
      const actif = (b.dataset.slug ?? '') in panier;
      b.setAttribute('aria-pressed', String(actif));
      const txt = b.querySelector('[data-panier-txt]');
      if (txt) txt.textContent = actif ? 'Dans ma liste' : 'Ajouter à ma liste';
    });
  };

  document.addEventListener('click', (e) => {
    const cible = e.target as HTMLElement;

    const fav = cible.closest<HTMLButtonElement>('[data-fav-btn]');
    if (fav?.dataset.slug) {
      e.preventDefault();
      basculerFavori(fav.dataset.slug);
      return;
    }

    const panier = cible.closest<HTMLButtonElement>('[data-panier-btn]');
    if (panier?.dataset.slug) {
      e.preventDefault();
      basculerPanier(panier.dataset.slug, Number(panier.dataset.portions) || 4);
    }
  });

  window.addEventListener(EVENEMENT_MAJ, synchroniser);
  synchroniser();
</script>
